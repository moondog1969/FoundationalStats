",\n       include.rownames = TRUE, size = \"footnotesize\")\n@\n\\end{table}\n\n\\begin{table}[H]\n%\\begin{tabular}\n\\centering\n\\caption{Raw proportions of the 15 most abundant 16S classes across sites. }\n\\label{tab:ch.site2}\n<<comment = NA, results=\"asis\", echo = F, tidy = T>>=\nprint(xtable(ch.sea3[1:15,], digits = c(0,0,4,4,4,4,4), align = c(rep(\"r\",5),\"|\",\"r\",\"r\")), type = \"latex\",\n       include.rownames = TRUE, size = \"footnotesize\")\n@\n\\end{table}\n\n\\begin{table}[H]\n%\\begin{tabular}\n\\centering\n\\caption{Raw proportions of the 20 most abundant 16S orders across sites. }\n\\label{tab:oh.site2}\n<<comment = NA, results=\"asis\", echo = F, tidy = T>>=\nprint(xtable(oh.sea3[1:20,], digits = c(0,0,4,4,4,4,4), align = c(rep(\"r\",5),\"|\",\"r\",\"r\")), type = \"latex\",\n       include.rownames = TRUE, size = \"footnotesize\")\n@\n\\end{table}\n\n\\begin{table}[H]\n%\\begin{tabular}\n\\centering\n\\caption{Raw proportions of the 25 most abundant 16S families across sites. }\n\\label{tab:fh.site2}\n<<comment = NA, results=\"asis\", echo = F, tidy = T>>=\nprint(xtable(fh.sea3[1:25,], digits = c(0,0,4,4,4,4,4), align = c(rep(\"r\",5),\"|\",\"r\",\"r\")), type = \"latex\",\n       include.rownames = TRUE, size = \"footnotesize\")\n@\n\\end{table}\n\n\\begin{table}[H]\n%\\begin{tabular}\n\\centering\n\\caption{Raw proportions of the 35 most abundant 16S genera across sites. }\n\\label{tab:gh.site2}\n<<comment = NA, results=\"asis\", echo = F, tidy = T>>=\nprint(xtable(gh.sea3[1:30,], digits = c(0,0,4,4,4,4,4), align = c(rep(\"r\",5),\"|\",\"r\",\"r\")), type = \"latex\",\n       include.rownames = TRUE, size = \"footnotesize\")\n@\n\\end{table}\n\n\\newpage\n\n<<tidy = T, echo = FALSE>>=\nnos <- c(resp$n, resc$n, reso$n, resf$n, resg$n)\nnofdrs <- c(length(resp$spp.fdr), length(resc$spp.fdr), length(reso$spp.fdr), length(resf$spp.fdr), length(resg$spp.fdr))\nout <- data.frame(matrix(ncol = 5, nrow = 3))\nout[1,] <- factor(c(np,nc,no,nf,ng