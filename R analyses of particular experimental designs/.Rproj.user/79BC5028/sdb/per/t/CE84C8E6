el of class (Table \\ref{tab:season1}).  Winter had the largest number of significant indicators, whereas spring and fall had the fewest indicators (Table \\ref{tab:season2}).  Significant season indicators remained for all taxonomic levels except phylum after controlling for false discovery rate \\citep{benjamini1995} (Tables \\ref{tab:season2}, \\ref{tab:season3}).\n\n<<echo = F, comment = NA>>=\nlibrary(plotrix)\nnp <- nlevels(factor(taxa[,2]))\nshared.p <- matrix(nrow=71, ncol=np, dimnames = list(names(rains.true),levels(factor(taxa[,2]))))\n\nnc <- nlevels(factor(taxa[,3]))\nshared.c <- matrix(nrow=71, ncol=nc, dimnames = list(names(rains.true),levels(factor(taxa[,3]))))\n\nnsc <- nlevels(factor(taxa[,4]))\nshared.sc <- matrix(nrow=71, ncol=nsc, dimnames = list(names(rains.true),levels(factor(taxa[,4]))))\n\nno <- nlevels(factor(taxa[,5]))\nshared.o <- matrix(nrow=71, ncol=no, dimnames = list(names(rains.true),levels(factor(taxa[,5]))))\n\nnso <- nlevels(factor(taxa[,6]))\nshared.so <- matrix(nrow=71, ncol=nso, dimnames = list(names(rains.true),levels(factor(taxa[,6]))))\n\nnf <- nlevels(factor(taxa[,7]))\nshared.f <- matrix(nrow=71, ncol=nf, dimnames = list(names(rains.true),levels(factor(taxa[,7]))))\n\nng <- nlevels(factor(taxa[,8]))\nshared.g <- matrix(nrow=71, ncol=ng, dimnames = list(names(rains.true),levels(factor(taxa[,8]))))\n\n\nfor(i in 1:71){\nshared.p[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,2])[1:83977]),sum)\n}\n\nshared.pc <- shared.p\nshared.p <- shared.p[,colnames(shared.p) != \"unclassified\"]\nshared.p <- shared.p[,colnames(shared.p) != \"uncultured\"]\nshared.p <- shared.p[,colnames(shared.p) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.c[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,3])[1:83977]),sum)\n}\n\nshared.cc <- shared.c\nshared.c <- shared.c[,colnames(shared.c) != \"unclassified\"]\nshared.c <- shared.c[,colnames(shared.c) != \"uncultured\"]\nshared.c <- shared.c[,colnames(shared.c) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.sc[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,4])[1:83977]),sum)\n}\n\ncolnames(shared.c) <- sub(\"Subsection\", \"Subsection \", colnames(shared.c))\n\nshared.scc <- shared.sc\nshared.sc <- shared.sc[,colnames(shared.sc) != \"unclassified\"]\nshared.sc <- shared.sc[,colnames(shared.sc) != \"uncultured\"]\nshared.sc <- shared.sc[,colnames(shared.sc) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.o[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,5])[1:83977]),sum)\n}\n\nshared.oc <- shared.o\nshared.o <- shared.o[,colnames(shared.o) != \"unclassified\"]\nshared.o <- shared.o[,colnames(shared.o) != \"uncultured\"]\nshared.o <- shared.o[,colnames(shared.o) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.so[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,6])[1:83977]),sum)\n}\n\nshared.soc <- shared.so\nshared.so <- shared.so[,colnames(shared.so) != \"unclassified\"]\nshared.so <- shared.so[,colnames(shared.so) != \"uncultured\"]\nshared.so <- shared.so[,colnames(shared.so) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.f[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,7])[1:83977]),sum)\n}\n\nshared.fc <- shared.f\nshared.f <- shared.f[,colnames(shared.f) != \"unclassified\"]\nshared.f <- shared.f[,colnames(shared.f) != \"uncultured\"]\nshared.f <- shared.f[,colnames(shared.f) != \"unnamed\"]\n\nfor(i in 1:71){\nshared.g[i,] <- tapply(t(rains.true[,i][1:83977]),droplevels(factor(taxa[,8])[1:83977]),sum)\n}\n\ncolnames(shared.g) <- sub(\"Enteric_Bacteria_cluster\", \"Enteric bacteria cluster\", colnames(shared.g))\n\n\nshared.gc <- shared.g\nshared.g <- shared.g[,colnames(shared.g) != \"unclassified\"]\nshared.g <- shared.g[,colnames(shared.g) != \"uncultured\"]\nshared.g <- shared.g[,colnames(shared.g) != \"unnamed\"]\n\n@\n\n\n\n<<echo = F>>=\n# resp = indval result\n# pct = piepercent\n# b = barplot result\n\nbar.summary <- function(resp, b, pct, cex.star = 1.2, cex.dag = 1.2){\n#resp = reso; b = bp$b; pct = bp$all; cex.star = 1.4; cex.dag = 1.4\n  ncol <- ncol(pct)\n  nrow <- nrow(pct)\n  cumsum <- apply(pct, 2, cumsum)\n\n  angles <- matrix(ncol = ncol, nrow = nrow)\n  angles[1,] <- cumsum[1,]/2\n  for(i in 2:nrow){\n    angles[i,] <- (cumsum[i,] + cumsum[(i-1),])/2\n  }\n\n  for(i in 1 : ncol){\n      nm <- match(rownames(resp$all)[resp$all[,1]==i],rownames(pct))\n      nom <- rownames(pct)[nm][!is.na(nm)]\n      nm1 <- match(names(resp$spp.fdr)[resp$spp.fdr==i],nom)\n      nom1 <- nom[nm1][!is.na(nm1)]\n      if(length(nom1) > 0){\n      nm2 <- match(nom1,rownames(pct))\n      txt1 <- rep(\"\",nrow)\n      txt1[nm2]<-\"**\"\n      text(rep(b[i], length(nm2)),angles[,i][nm2],txt1[nm2], cex = cex.dag) #significant FDR\n      }\n\n      if(length(nm[!is.na(nm)])==0 || (all(is.na(nm1)) & all(is.na(nm)))) {nm2 <- integer(); nm3 <- nm2}\n      if(length(nm[!is.na(nm)]) > 0 & all(is.na(nm1)) & !all(is.na(nm))) {\n        nm3 <- nm[!is.na(nm)]\n        nom3 <- nom }\n      if(length(nm) > 0 & !all(is.na(nm)) & !all(is.na(nm1))) {\n\n        nm2.5 <- match(nm2,nm); nm3 <- nm[-as.vector(nm2.5)]; nm3 <- nm3[!is.na(nm3)]}\n\n      txt1 <- rep(\"\",nrow)\n      if(length(nm3) > 0) txt1[as.vector(nm3)]<-\"*\"\n      if(length(nm3) > 0) text(rep(b[i], length(nm3)),angles[,i][nm3],txt1[nm3], cex = cex.star) #significant\n\n  }\n}\n\n\n@\n\n\n\n\n<<echo = F, comment = NA>>=\nxls.col16 <- function(n){\ncols <- c(\"#3C6B9B\",\"#A33A42\",\"#7F9B45\",\"#685185\",\"#438BA0\",\"#D6763E\",\"#4F81BF\",\"#CD4852\",\"#9CBA4E\",\"#835EA2\",\"#58ABBA\",\"#F0994C\",\"#BBC3C9\",\"#D9AAA3\",\"#C3D6A2\",\"#B8AED0\",gray(seq(95,50,length=7)/100)) \nout <- cols[1:n]\nout\n}\n  \n.simpleCap <- function(x) {\n    s <- strsplit(x, \" \")[[1]]\n    paste(toupper(substring(s, 1, 1)), substring(s, 2),\n          sep = \"\", collapse = \" \")\n  }\n\nbarplot.microbe <- function(resp = resp, pieces = 8, shared = shared.pc, cat = new.meta$Season, cex.leg = .9, \n                            pt.cex = 1, title = \"Phylum\", inset = c(-.4,0), mar = c(5,4.8,2,14), xpd = FALSE, ncol = 1, \n                            ylab = \"Percent of total reads\", col = xls.col16(pieces+1), ...){\n  \n  lvls <- levels(factor(cat))\n  cap.lvls <- as.vector(sapply(lvls, function(x) .simpleCap(x)))\n  \n  lvls.shared <- list()\n  for(i in 1:length(lvls)){\n    lvls.shared[[i]] <- shared[cat == lvls[i],]\n  }\n  names(lvls.shared) <- lvls\n  sums <- apply(shared > 0, 2, sum); npp <- length(sums[sums!=1])\n  \n  \n  sums.mat <- matrix(nrow = ncol(shared), ncol = length(lvls),  dimnames = list(colnames(shared), lvls))\n  for(i in 1:length(lvls)){\n    sums.mat[,i] <- apply(lvls.shared[[i]], 2, sum)\n  }\n  o <- order(apply(sums.mat,1,sum), decreasing = T)\n  \n  sums.mato <- sums.mat[o,][1:pieces,]\n  other <- apply(sums.mat[o,][(pieces+1):npp,],2,sum)\n  pie <- data.frame(rbind(sums.mato, other))\n  all <- apply(pie, 2, function(x)(100*x/sum(x)))\n  \n  par(mar = mar)\n  b <- barplot(as.matrix(all), border = col, col = col, ylab = ylab, names.arg = cap.lvls, xpd = xpd, ...)\n  \n  \n  sig <- !is.na(match(rownames(all)[(pieces+1):1],rownames(resp$all)))\n  sig.fdr <- !is.na(match(rownames(all)[(pieces+1):1],names(resp$spp.fdr)))\n  \n  tau.vals <- rownames(all)[(pieces+1):1]\n  leg <- vector(\"expression\", length(tau.vals))\n  for(i in 1:length(tau.vals)){\n    leg[i] <- if(sig[i] & !sig.fdr[i]){\n      substitute(expression(bold(tauval)),\n                 list(tauval=tau.vals[i]))[2]}\n    else if(sig[i] & sig.fdr[i]){\n      substitute(expression(underline(bold(tauval))),\n                 list(tauval=tau.vals[i]))[2]}\n    else tau.vals[i]\n  }\n  \n  legend(x=\"topright\",legend=leg, col = col[(pieces+1):1], pch = 15,  cex = cex.leg, pt.cex = pt.cex, bty = \"n\", xpd = NA, inset=inset, ncol = ncol, title = title)\n  res <- list()\n  res$all <- all\n  res$b <- b\n  res\n}\n\n\n\n\n@\n\n\n<<echo = F, comment = NA>>=\n#----------- phylum----------#\nn <- 