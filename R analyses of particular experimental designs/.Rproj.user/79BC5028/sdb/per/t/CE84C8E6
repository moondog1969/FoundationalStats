 <- length(sums[sums>=n])\no <- order(apply(shared.f, 2, sum), decreasing = T)\nindf <- indval(log1p(shared.f[,o][,1:nf]), site, p = .06, numitr = 1000) # family\nresf <- summarize(indf)\n@\n\n\\begin{figure}[H]\n<<echo = F, comment = NA>>=\nbp <- barplot.microbe(resp = resf, pieces = 20, shared = shared.fc, cat = site, ylim = c(0,100), xpd = FALSE, inset = c(-.67,0), mar = c(5,4.8,2,13), pt.cex = 1.1, cex.leg = 1.1, cex.names = 1.2, cex.lab = 1.2, title = \"Family\")\n\n#axis(2, at = seq(40,100,10), labels = c(0,seq(50,100,10)))\n#axis.break(axis=2, 35)\nbar.summary(resp = resf, b = bp$b, pct = bp$all, cex.star = 1.4, cex.dag = 1.4)\n@\n\\caption{Percentages of dominant 16S families across all sites. Asterisks (*) indicate significant (at $\\alpha = 0.05$) indicator and are accompanied by bold font entries in the legend. Double asterisks (**) indicate significant indicator after controlling for FDR and are accompanied by bold and underlined entries in the legend.}\n\\label{ISA.site.families}\n\\end{figure}\n\n<<echo = F, comment = NA>>=\n#----------- genus----------#\nsums <- apply(shared.g > 0, 2, sum); ng <- length(sums[sums>=n])\no <- order(apply(shared.g > 0, 2, sum), decreasing = T)\nig <- indval(log1p(shared.g[,o][,1:ng]), site, p = .06, numitr = 1000) # genus\nresg <- summarize(ig)\n@\n\n\\begin{figure}[H]\n<<echo = F, comment = NA>>=\nbp <- barplot.microbe(resp = resg, pieces = 20, shared = shared.gc, cat = site, ylim = c(30,100), xpd = FALSE, inset = c(-.77,0), mar = c(5,4.8,2,13), pt.cex = 1.1, cex.leg = 1.1, cex.names = 1.2, cex.lab = 1.2, title = \"Genus\", yaxt = \"n\")\n\naxis(2, at = seq(30,100,10), labels = c(0,seq(40,100,10)))\naxis.break(axis=2, 35)\nbar.summary(resp = resg, b = bp$b, pct = bp$all, cex.star = 1.4, cex.dag = 1.4)\n@\n\\caption{Percentages of dominant 16S genera across all sites. Asterisks (*) indicate significant (at $\\alpha = 0.05$) indicator and are accompanied by bold font entries in the legend. Double asterisks (**) indicate s