library(asbio); data(asthma)
m <- as.matrix(asthma[,3:10]) # ignore baseline
asthma.lm <- lm(m ~ DRUG) # multivariate general linear model
hr <- ordered(seq(11, 18))
summary(Anova(r, idesign =~hr, idata = data.frame(hr)),
multivariate = FALSE)
library(car)
library(asbio); data(asthma)
m <- as.matrix(asthma[,3:10]) # ignore baseline
asthma.lm <- lm(m ~ DRUG) # multivariate general linear model
hr <- ordered(seq(11, 18))
summary(Anova(asthma.lm, idesign =~hr, idata = data.frame(hr)),
multivariate = FALSE)
m <- as.matrix(asthma[,3:10]) # ignore baseline
asthma.lm <- lm(m ~ DRUG, data = asthma) # multivariate general linear model
hr <- ordered(seq(11, 18))
summary(Anova(asthma.lm, idesign =~hr, idata = data.frame(hr)),
multivariate = FALSE)
